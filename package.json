{
  "name": "shishu",
  "version": "0.1.0",
  "private": true,
  "description": "Shishu — gentle multilingual learning for children (ages 2-12). Open source, free, low-stimulation.",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "validate:content": "pnpm --filter content-schema validate"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@testing-library/dom": "^10.4.2"
  }
}
