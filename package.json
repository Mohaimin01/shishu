{
  "name": "shishu",
  "version": "0.1.0",
  "private": true,
  "description": "Shishu — gentle multilingual learning for children (ages 2-12). Open source, free, low-stimulation.",
  "scripts": {
    "dev": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "test": "npm test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "validate:content": "npx tsx packages/content-schema/src/validate.ts"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@testing-library/dom": "^10.4.2"
  }
}
